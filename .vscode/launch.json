    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debugging dataloading",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Debug GRAB DataModule",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.debug_grab_datamodule",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "args": "${command:pickArgs}"
        }
    ]
}