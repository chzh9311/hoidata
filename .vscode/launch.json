{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debugging dataloading",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Debug GRAB DataModule",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.debug_grab_datamodule",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "args": "${command:pickArgs}"
        },
        {
            "name": "DoF Analysis",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.dof_analysis",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            // "args": "${command:pickArgs}"
        },
        {
            // Launch the web viewer in wrist-aligned mode under the debugger.
            // Set breakpoints in hoidata/vis/o3d_visualizer.py ->
            // pose_wrist_aligned_sample (and _fit_fixed_axis_motion) and open a
            // sequence in the browser to trigger posing; inspect wrist_R,
            // wrist_o, R_true/t_true, R_rec/t_rec, obj_true/obj_rec live.
            "name": "Debug wrist-aligned viewer",
            "type": "debugpy",
            "request": "launch",
            "module": "hoidata.vis.web_viewer.run",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "python": "/home/zxc417/anaconda3/envs/hoi_common/bin/python",
            "args": [
                "--config", "configs/grab.yaml",
                "--split", "test",
                "--wrist-aligned"
            ]
        },
        {
            // Launch the web viewer on the bimanual (merged-hand) transition
            // dataset.  Set breakpoints in grab_dataset.py ->
            // BimanualTransitionMotionGRAB._bimanual_transitions and in
            // o3d_visualizer.py -> pose_bimanual_transition_sample.
            "name": "Debug bimanual transition viewer",
            "type": "debugpy",
            "request": "launch",
            "module": "hoidata.vis.web_viewer.run",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "python": "/home/zxc417/anaconda3/envs/hoi_common/bin/python",
            "args": [
                "--config", "configs/grab.yaml",
                "--split", "test",
                "--bimanual",
                "--aug-p", "0"
            ]
        },
        {
            // Launch the web viewer on the bimanual stable-grasp dataset in the
            // WORLD frame (no wrist alignment, no 1-DOF fit).  Breakpoints:
            // grab_dataset.py -> StableGraspMotionDataset._build_bimanual_stable_grasps
            // and o3d_visualizer.py -> pose_bimanual_stable_grasp_sample.
            "name": "Debug bimanual stable-grasp viewer",
            "type": "debugpy",
            "request": "launch",
            "module": "hoidata.vis.web_viewer.run",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "python": "/home/zxc417/anaconda3/envs/hoi_common/bin/python",
            "args": [
                "--config", "configs/grab.yaml",
                "--split", "test",
                "--stable-grasp"
            ]
        },
        {
            // Same viewer, but let you type extra args at launch (e.g. a
            // different --split / --port) via the arg picker.
            "name": "Debug wrist-aligned viewer (pick args)",
            "type": "debugpy",
            "request": "launch",
            "module": "hoidata.vis.web_viewer.run",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "python": "/home/zxc417/anaconda3/envs/hoi_common/bin/python",
            "args": "${command:pickArgs}"
        }
    ]
}